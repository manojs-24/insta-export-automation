# Copy to .env and edit. .env is gitignored; real environment variables override it.

# Page opened by the smoke test
WA_URL=https://www.instagram.com/

# Dedicated automation profile (stored under WA_PROFILE_ROOT/<name>)
WA_PROFILE=script
WA_PROFILE_ROOT=browser_data

# Headed mode is the default; set true to hide the window
WA_HEADLESS=false

# Playwright channel for installed Google Chrome
WA_CHROME_CHANNEL=chrome

# Default action timeout in milliseconds
WA_TIMEOUT_MS=30000


# Where downloaded exports (zip) and extracted files are saved. Gitignored; holds personal data.
WA_EXPORT_DIR=exports

# Instagram username the export must belong to. The workflow checks the review screen
# contains it before clicking "Start export".
WA_EXPECTED_ACCOUNT=

# Optional auto-login when Instagram shows its login page. Leave blank to log in by hand.
# The OTP / 2FA code is NEVER stored: you type it in the Chrome window.
WA_IG_USERNAME=
WA_IG_PASSWORD=
# Seconds to wait for login + OTP to finish
WA_LOGIN_TIMEOUT_S=300

# Hosted Postgres for run history, logs and followers. Contains a password: keep it only here.
# Format: postgresql://user:password@host:5432/dbname
WA_DATABASE_URL=

# ---- Automatic runs (only while the web UI, web-automation --ui, is open) ----
# Minutes between automatic runs. 0 or empty = off. Allowed: 5 to 10080 (one week).
WA_SCHEDULE_MINUTES=360
# Which file in configs/ the schedule runs.
WA_SCHEDULE_CONFIG=instagram_export.json
# How long a run waits for you to type the OTP code / answer a question before giving up (1-240).
WA_ANSWER_WAIT_MINUTES=10

# ---- Sign in to the web UI (optional) ----
# Set BOTH to get a sign-in page at http://127.0.0.1:8000/ instead of the one-time link.
# The password needs at least 8 characters. Leave both empty to keep using the token link.
WA_UI_USERNAME=
WA_UI_PASSWORD=
